--3•combien avons nous vendu au totale
SELECT sum(p.prix*quantite) as totale_vende  
from ventes v,produits p
 where p.id=v.id_produit;

--4•quels pays génére le plus de ventes
select c.pays,sum(p.prix*quantite) as totale_vente 
from ventes v,produits p , clients c
 where p.id=v.id_produit and c.id=v.id_client 
group by c.pays
LIMIT 10 ;
