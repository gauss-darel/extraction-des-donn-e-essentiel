---creation des tables---
CREATE TABLE clients(
    id INT generated always as identity primary key,
    nom text not null,
    pays text not null,
    date_creation date
);

CREATE TABLE produits(
    id INT moi2008
     primary key,
    nom text not null,
    prix numeric(10,2) not null

) ;

create TABLE ventes(
    id INT generated always as identity primary key,
    id_client int not null references clients,
    id_produit int not null references produits,
    quantite int check (quantite > 0),
    date_vente date not null
);
